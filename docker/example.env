MEDIARR_VERSION=latest
DB_USER=mediarr
DB_PASSWORD=change-me
UPLOAD_LOCATION=/path/to/mediarr/library
CACHE_LOCATION=/path/to/mediarr/cache
DB_LOCATION=/path/to/mediarr/db
PUID=1000
PGID=1000
BIND_ADDRESS=0.0.0.0
HTTP_PORT=9851

# Optional: smart search and faces.
# COMPOSE_PROFILES=ml
# Optional: TVs on the home network browse albums (DLNA). Add dlna to the profiles, e.g.
# COMPOSE_PROFILES=ml,dlna, then turn on the DLNA server in Administration > Settings.
# DLNA_PORT=8200
# ML_URL=http://ml:8000
# Minutes without a request before a model leaves memory. 0 keeps models loaded.
# ML_IDLE_MINUTES=5
# Token for a service on another computer: set the same value on both sides. See the smart search docs.
# ML_TOKEN=
